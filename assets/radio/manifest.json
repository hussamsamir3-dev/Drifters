{"version":1,"voice":"Expressive Race Engineer (English)","cues":[{"id":"radio_check","category":"startup","file":"startup/radio_check.mp3","duration":2.353,"priority":40,"cooldown":20,"text":"Radio check. Can you hear me?","ar":"فحص الراديو. هل تسمعني؟","pin":1},{"id":"radio_confirmed","category":"startup","file":"startup/radio_confirmed.mp3","duration":2.763,"priority":40,"cooldown":20,"text":"Loud and clear. Radio is good.","ar":"واضح وصوتك ممتاز. الراديو سليم.","pin":1},{"id":"grid_ready","category":"startup","file":"startup/grid_ready.mp3","duration":2.616,"priority":40,"cooldown":20,"text":"You're in position. Stay focused.","ar":"أنت في موقعك. ركّز.","pin":1},{"id":"start_go","category":"startup","file":"startup/start_go.mp3","duration":1.894,"priority":40,"cooldown":20,"text":"Go, go, go!","ar":"انطلق، انطلق!","pin":1},{"id":"good_start","category":"startup","file":"startup/good_start.mp3","duration":2.496,"priority":40,"cooldown":20,"text":"Great launch! Keep it clean into turn one.","ar":"انطلاقة رائعة! حافظ على نظافة القيادة حتى المنعطف الأول."},{"id":"poor_start","category":"startup","file":"startup/poor_start.mp3","duration":3.571,"priority":40,"cooldown":20,"text":"Okay, tough start. Plenty of race left.","ar":"انطلاقة صعبة. لا يزال السباق طويلاً."},{"id":"car_left","category":"spotter","file":"spotter/car_left.mp3","duration":1.241,"priority":100,"cooldown":3,"text":"Car left!","ar":"سيارة على اليسار!","pin":1},{"id":"still_left","category":"spotter","file":"spotter/still_left.mp3","duration":2.067,"priority":100,"cooldown":3,"text":"Still there, on your left.","ar":"ما زالت على يسارك.","pin":1},{"id":"clear_left","category":"spotter","file":"spotter/clear_left.mp3","duration":1.385,"priority":100,"cooldown":3,"text":"Clear left.","ar":"اليسار فارغ.","pin":1},{"id":"car_right","category":"spotter","file":"spotter/car_right.mp3","duration":1.205,"priority":100,"cooldown":3,"text":"Car right!","ar":"سيارة على اليمين!","pin":1},{"id":"still_right","category":"spotter","file":"spotter/still_right.mp3","duration":2.133,"priority":100,"cooldown":3,"text":"Still there, on your right.","ar":"ما زالت على يمينك.","pin":1},{"id":"clear_right","category":"spotter","file":"spotter/clear_right.mp3","duration":0.902,"priority":100,"cooldown":3,"text":"Clear right.","ar":"اليمين فارغ.","pin":1},{"id":"both_sides","category":"spotter","file":"spotter/both_sides.mp3","duration":2.84,"priority":100,"cooldown":3,"text":"Cars both sides! Hold your line!","ar":"سيارات على الجانبين! ثبّت خطك!","pin":1},{"id":"three_wide","category":"spotter","file":"spotter/three_wide.mp3","duration":2.48,"priority":100,"cooldown":3,"text":"Three wide! Stay in your lane!","ar":"ثلاث سيارات بالعرض! ابقَ في مسارك!","pin":1},{"id":"all_clear","category":"spotter","file":"spotter/all_clear.mp3","duration":2.321,"priority":100,"cooldown":3,"text":"All clear. You're clear to move.","ar":"الطريق خالٍ. تحرّك براحتك.","pin":1},{"id":"closing_fast","category":"spotter","file":"spotter/closing_fast.mp3","duration":2.373,"priority":100,"cooldown":3,"text":"Car behind is closing fast.","ar":"السيارة خلفك تقترب بسرعة.","pin":1},{"id":"inside_attack","category":"spotter","file":"spotter/inside_attack.mp3","duration":1.775,"priority":100,"cooldown":3,"text":"They're looking up the inside!","ar":"يحاولون المرور من الداخل!"},{"id":"outside_attack","category":"spotter","file":"spotter/outside_attack.mp3","duration":1.845,"priority":100,"cooldown":3,"text":"They're going around the outside.","ar":"يحاولون المرور من الخارج."},{"id":"rejoin_wait","category":"spotter","file":"spotter/rejoin_wait.mp3","duration":2.565,"priority":100,"cooldown":3,"text":"Wait! Traffic coming. Hold position.","ar":"انتظر! سيارات قادمة. ثبّت مكانك."},{"id":"rejoin_clear","category":"spotter","file":"spotter/rejoin_clear.mp3","duration":2.551,"priority":100,"cooldown":3,"text":"Track is clear. Rejoin carefully.","ar":"المسار خالٍ. عُد بحذر."},{"id":"stopped_ahead","category":"spotter","file":"spotter/stopped_ahead.mp3","duration":2.165,"priority":100,"cooldown":3,"text":"Stopped car ahead! Slow down!","ar":"سيارة متوقفة أمامك! خفّف السرعة!","pin":1},{"id":"crash_ahead","category":"spotter","file":"spotter/crash_ahead.mp3","duration":3.525,"priority":100,"cooldown":3,"text":"Crash ahead! Lift off. Find a safe gap.","ar":"حادث أمامك! ارفع قدمك. ابحث عن فسحة آمنة.","pin":1},{"id":"wrong_way","category":"spotter","file":"spotter/wrong_way.mp3","duration":3.885,"priority":100,"cooldown":3,"text":"You're facing the wrong way. Turn around safely.","ar":"أنت في الاتجاه المعاكس. استدر بأمان.","pin":1},{"id":"pit_exit_traffic","category":"spotter","file":"spotter/pit_exit_traffic.mp3","duration":2.884,"priority":100,"cooldown":3,"text":"Traffic at pit exit. Watch the blend line.","ar":"سيارات عند مخرج الصيانة. انتبه لخط الاندماج."},{"id":"overtake_good","category":"racecraft","file":"racecraft/overtake_good.mp3","duration":3.435,"priority":40,"cooldown":20,"text":"Yes! Brilliant overtake. Nicely done!","ar":"ممتاز! تجاوز رائع. أحسنت!"},{"id":"overtake_clean","category":"racecraft","file":"racecraft/overtake_clean.mp3","duration":2.121,"priority":40,"cooldown":20,"text":"Clean move. Good work.","ar":"حركة نظيفة. عمل جيد."},{"id":"lead_taken","category":"racecraft","file":"racecraft/lead_taken.mp3","duration":2.885,"priority":40,"cooldown":20,"text":"That's the lead! Beautiful driving!","ar":"أنت في الصدارة! قيادة رائعة!"},{"id":"position_lost","category":"racecraft","file":"racecraft/position_lost.mp3","duration":2.706,"priority":40,"cooldown":20,"text":"We've lost a place. Stay calm.","ar":"خسرنا مركزاً. حافظ على هدوئك."},{"id":"defend","category":"racecraft","file":"racecraft/defend.mp3","duration":2.92,"priority":40,"cooldown":20,"text":"Defend your position. Keep it fair.","ar":"دافع عن مركزك. بنزاهة."},{"id":"attack_now","category":"racecraft","file":"racecraft/attack_now.mp3","duration":2.773,"priority":40,"cooldown":20,"text":"This is your chance. Go for the move!","ar":"هذه فرصتك. هيا بالتجاوز!"},{"id":"avoid_contact","category":"racecraft","file":"racecraft/avoid_contact.mp3","duration":3.812,"priority":40,"cooldown":20,"text":"Careful! Give them space. Avoid contact.","ar":"انتبه! أعطهم مساحة. تجنّب الاحتكاك."},{"id":"contact_light","category":"racecraft","file":"racecraft/contact_light.mp3","duration":3.262,"priority":40,"cooldown":20,"text":"We've had contact. Check how the car feels.","ar":"حصل احتكاك. تحقق من حالة السيارة.","pin":1},{"id":"contact_heavy","category":"racecraft","file":"racecraft/contact_heavy.mp3","duration":2.407,"priority":40,"cooldown":20,"text":"That was a big hit! Are you okay?","ar":"ضربة قوية! هل أنت بخير؟","pin":1},{"id":"spin_recover","category":"racecraft","file":"racecraft/spin_recover.mp3","duration":5.376,"priority":40,"cooldown":20,"text":"Easy. Get it straight. Check traffic before you rejoin.","ar":"بهدوء. عدّل السيارة. تأكد من الزحام قبل العودة."},{"id":"reset_focus","category":"racecraft","file":"racecraft/reset_focus.mp3","duration":3.205,"priority":40,"cooldown":20,"text":"Forget that corner. Focus on the next one.","ar":"انسَ هذا المنعطف. ركّز على التالي."},{"id":"lapping_traffic","category":"racecraft","file":"racecraft/lapping_traffic.mp3","duration":3.324,"priority":40,"cooldown":20,"text":"You're catching lapped traffic. Be patient.","ar":"تقترب من سيارات متأخرة بلفة. تحلَّ بالصبر."},{"id":"gap_opening","category":"racecraft","file":"racecraft/gap_opening.mp3","duration":2.439,"priority":40,"cooldown":20,"text":"Good pace. You're pulling away.","ar":"وتيرة ممتازة. أنت تبتعد."},{"id":"gap_closing","category":"racecraft","file":"racecraft/gap_closing.mp3","duration":2.659,"priority":40,"cooldown":20,"text":"You're catching the car ahead. Keep it going.","ar":"تقترب من السيارة التي أمامك. واصل."},{"id":"gap_losing","category":"racecraft","file":"racecraft/gap_losing.mp3","duration":1.94,"priority":40,"cooldown":20,"text":"We're losing time to the car ahead.","ar":"نخسر الوقت أمام السيارة التي أمامك."},{"id":"lap_one","category":"laps","file":"laps/lap_one.mp3","duration":2.485,"priority":40,"cooldown":20,"text":"First lap. Keep it clean.","ar":"اللفة الأولى. حافظ على النظافة."},{"id":"halfway","category":"laps","file":"laps/halfway.mp3","duration":1.705,"priority":40,"cooldown":20,"text":"We're halfway through the race.","ar":"وصلنا منتصف السباق."},{"id":"ten_laps","category":"laps","file":"laps/ten_laps.mp3","duration":2.405,"priority":40,"cooldown":20,"text":"Ten laps remaining.","ar":"تبقّت عشر لفات."},{"id":"five_laps","category":"laps","file":"laps/five_laps.mp3","duration":2.537,"priority":40,"cooldown":20,"text":"Five laps to go. Stay focused.","ar":"خمس لفات للنهاية. ركّز."},{"id":"three_laps","category":"laps","file":"laps/three_laps.mp3","duration":1.48,"priority":40,"cooldown":20,"text":"Three laps remaining.","ar":"تبقّت ثلاث لفات."},{"id":"two_laps","category":"laps","file":"laps/two_laps.mp3","duration":2.917,"priority":40,"cooldown":20,"text":"Two laps to go. Give it everything.","ar":"لفتان للنهاية. أعطِ كل ما لديك."},{"id":"final_lap","category":"laps","file":"laps/final_lap.mp3","duration":2.165,"priority":40,"cooldown":20,"text":"Final lap! Bring it home!","ar":"اللفة الأخيرة! أوصلها للنهاية!"},{"id":"personal_best","category":"laps","file":"laps/personal_best.mp3","duration":2.683,"priority":40,"cooldown":20,"text":"Personal best! That's a strong lap.","ar":"رقم شخصي جديد! لفة قوية."},{"id":"fastest_lap","category":"laps","file":"laps/fastest_lap.mp3","duration":2.885,"priority":40,"cooldown":20,"text":"Fastest lap of the race! Outstanding!","ar":"أسرع لفة في السباق! رائع!"},{"id":"pace_good","category":"laps","file":"laps/pace_good.mp3","duration":2.085,"priority":40,"cooldown":20,"text":"That pace is excellent. Keep it up.","ar":"وتيرة ممتازة. استمر."},{"id":"pace_slow","category":"laps","file":"laps/pace_slow.mp3","duration":3.819,"priority":40,"cooldown":20,"text":"We need more pace. Focus on your corner exits.","ar":"نحتاج وتيرة أعلى. ركّز على الخروج من المنعطفات."},{"id":"sector_good","category":"laps","file":"laps/sector_good.mp3","duration":2.799,"priority":40,"cooldown":20,"text":"Great sector. You're finding time.","ar":"قطاع رائع. أنت تكسب الوقت."},{"id":"blue","category":"flags","file":"flags/blue.mp3","duration":2.922,"priority":90,"cooldown":20,"text":"Blue flag. Let the faster car through.","ar":"العلم الأزرق. دع السيارة الأسرع تمرّ.","pin":1},{"id":"slippery","category":"flags","file":"flags/slippery.mp3","duration":2.565,"priority":90,"cooldown":20,"text":"Slippery surface ahead. Take care.","ar":"سطح زلق أمامك. انتبه.","pin":1},{"id":"safety_car","category":"flags","file":"flags/safety_car.mp3","duration":4.047,"priority":90,"cooldown":20,"text":"Safety car deployed. Slow down. No overtaking.","ar":"سيارة الأمان على المسار. خفّف السرعة. ممنوع التجاوز.","pin":1},{"id":"safety_car_in","category":"flags","file":"flags/safety_car_in.mp3","duration":2.457,"priority":90,"cooldown":20,"text":"Safety car in this lap. Get ready.","ar":"سيارة الأمان تدخل هذه اللفة. استعد."},{"id":"restart_go","category":"flags","file":"flags/restart_go.mp3","duration":2.309,"priority":90,"cooldown":20,"text":"Green, green! Racing again!","ar":"أخضر، أخضر! السباق يعود!","pin":1},{"id":"box_now","category":"pit","file":"pit/box_now.mp3","duration":2.519,"priority":75,"cooldown":20,"text":"Box, box! Pit this lap.","ar":"ادخل الصيانة، ادخل الصيانة! هذه اللفة."},{"id":"pit_entry","category":"pit","file":"pit/pit_entry.mp3","duration":2.55,"priority":75,"cooldown":20,"text":"Pit entry ahead. Watch your speed.","ar":"مدخل الصيانة أمامك. انتبه لسرعتك."},{"id":"pit_limiter","category":"pit","file":"pit/pit_limiter.mp3","duration":2.571,"priority":75,"cooldown":20,"text":"Pit limiter on. Keep below the limit.","ar":"محدد السرعة يعمل. ابقَ تحت الحد.","pin":1},{"id":"pit_stop","category":"pit","file":"pit/pit_stop.mp3","duration":3.204,"priority":75,"cooldown":20,"text":"Stop on your marks. The crew is ready.","ar":"قف على علامتك. الطاقم جاهز.","pin":1},{"id":"pit_release","category":"pit","file":"pit/pit_release.mp3","duration":1.784,"priority":75,"cooldown":20,"text":"Go, go! You're released!","ar":"انطلق، انطلق! تم إطلاقك!","pin":1},{"id":"pit_good","category":"pit","file":"pit/pit_good.mp3","duration":2.501,"priority":75,"cooldown":20,"text":"Great stop. Now build the pace.","ar":"توقف ممتاز. الآن ارفع الوتيرة."},{"id":"pit_slow","category":"pit","file":"pit/pit_slow.mp3","duration":2.787,"priority":75,"cooldown":20,"text":"Slow stop. We'll recover on track.","ar":"توقف بطيء. سنعوّض على المسار."},{"id":"repair_pit","category":"pit","file":"pit/repair_pit.mp3","duration":2.78,"priority":75,"cooldown":20,"text":"Box for repairs. The crew is ready.","ar":"ادخل الصيانة للإصلاح. الطاقم جاهز."},{"id":"tyres_cold","category":"car","file":"car/tyres_cold.mp3","duration":3.223,"priority":85,"cooldown":20,"text":"Tyres are cold. Build temperature gradually.","ar":"الإطارات باردة. ارفع حرارتها تدريجياً."},{"id":"tyres_ready","category":"car","file":"car/tyres_ready.mp3","duration":1.723,"priority":85,"cooldown":20,"text":"Tyres are in the working window.","ar":"الإطارات في النطاق المثالي."},{"id":"tyres_hot","category":"car","file":"car/tyres_hot.mp3","duration":3.159,"priority":85,"cooldown":20,"text":"Tyres are overheating. Ease off the sliding.","ar":"الإطارات تسخن زيادة. خفّف الانزلاق."},{"id":"tyres_worn","category":"car","file":"car/tyres_worn.mp3","duration":3.27,"priority":85,"cooldown":20,"text":"Tyres are wearing out. Manage your grip.","ar":"الإطارات تتآكل. حافظ على التماسك."},{"id":"brakes_hot","category":"car","file":"car/brakes_hot.mp3","duration":3.224,"priority":85,"cooldown":20,"text":"Brake temperatures are high. Give them a chance to cool.","ar":"حرارة الفرامل عالية. أعطها فرصة لتبرد."},{"id":"fuel_low","category":"car","file":"car/fuel_low.mp3","duration":2.725,"priority":85,"cooldown":20,"text":"Fuel is getting low. Start saving.","ar":"الوقود يقلّ. ابدأ التوفير."},{"id":"fuel_critical","category":"car","file":"car/fuel_critical.mp3","duration":3.365,"priority":85,"cooldown":20,"text":"Fuel is critical. Lift and coast now.","ar":"الوقود حرج. ارفع قدمك وانساب الآن.","pin":1},{"id":"fuel_good","category":"car","file":"car/fuel_good.mp3","duration":1.925,"priority":85,"cooldown":20,"text":"Fuel is good to the finish.","ar":"الوقود يكفي حتى النهاية."},{"id":"engine_hot","category":"car","file":"car/engine_hot.mp3","duration":3.048,"priority":85,"cooldown":20,"text":"Engine temperature is high. Reduce the load.","ar":"حرارة المحرك عالية. خفّف الحمل.","pin":1},{"id":"engine_problem","category":"car","file":"car/engine_problem.mp3","duration":3.492,"priority":85,"cooldown":20,"text":"Engine problem detected. Bring the revs down.","ar":"عطل في المحرك. اخفض الدورات."},{"id":"gearbox_problem","category":"car","file":"car/gearbox_problem.mp3","duration":3.112,"priority":85,"cooldown":20,"text":"Gearbox issue. Be gentle with the shifts.","ar":"مشكلة في ناقل الحركة. بلطف مع التغييرات."},{"id":"steering_damage","category":"car","file":"car/steering_damage.mp3","duration":3.045,"priority":85,"cooldown":20,"text":"Steering damage detected. Check your control.","ar":"ضرر في المقود. انتبه للتحكم."},{"id":"suspension_damage","category":"car","file":"car/suspension_damage.mp3","duration":3.111,"priority":85,"cooldown":20,"text":"Suspension damage. Take it easy.","ar":"ضرر في التعليق. بهدوء."},{"id":"body_damage","category":"car","file":"car/body_damage.mp3","duration":3.205,"priority":85,"cooldown":20,"text":"Bodywork damage. We're monitoring the car.","ar":"ضرر في الهيكل. نراقب السيارة."},{"id":"car_unsafe","category":"car","file":"car/car_unsafe.mp3","duration":3.637,"priority":85,"cooldown":20,"text":"The car is unsafe to continue. Stop somewhere safe.","ar":"السيارة غير آمنة للمتابعة. قف في مكان آمن.","pin":1},{"id":"boost_ready","category":"car","file":"car/boost_ready.mp3","duration":2.886,"priority":85,"cooldown":20,"text":"Boost is available.","ar":"التعزيز متاح."},{"id":"boost_empty","category":"car","file":"car/boost_empty.mp3","duration":2.522,"priority":85,"cooldown":20,"text":"Boost is depleted.","ar":"التعزيز فرغ."},{"id":"rain_started","category":"weather","file":"weather/rain_started.mp3","duration":2.788,"priority":40,"cooldown":20,"text":"Rain has started. Be careful on the slicks.","ar":"بدأ المطر. احذر على الإطارات الجافة."},{"id":"rain_heavy","category":"weather","file":"weather/rain_heavy.mp3","duration":3.74,"priority":40,"cooldown":20,"text":"Rain is getting heavier. Visibility is dropping.","ar":"المطر يشتد. الرؤية تنخفض."},{"id":"wet_tyres","category":"weather","file":"weather/wet_tyres.mp3","duration":3.096,"priority":40,"cooldown":20,"text":"Conditions suit wet tyres. Box for a change.","ar":"الظروف تناسب إطارات المطر. ادخل للتبديل."},{"id":"low_visibility","category":"weather","file":"weather/low_visibility.mp3","duration":2.965,"priority":40,"cooldown":20,"text":"Visibility is poor. Leave extra space.","ar":"الرؤية ضعيفة. اترك مسافة إضافية."},{"id":"win","category":"finish","file":"finish/win.mp3","duration":5.782,"priority":60,"cooldown":0,"text":"You've won it! Yes! Incredible drive! Absolutely brilliant!","ar":"فزت! نعم! قيادة مذهلة! رائع تماماً!"},{"id":"finish_good","category":"finish","file":"finish/finish_good.mp3","duration":4.328,"priority":60,"cooldown":0,"text":"Chequered flag. Great drive. Really solid work.","ar":"علم النهاية. قيادة جميلة. عمل متين فعلاً."},{"id":"finish_tough","category":"finish","file":"finish/finish_tough.mp3","duration":4.466,"priority":60,"cooldown":0,"text":"Chequered flag. Tough race. We'll learn from it.","ar":"علم النهاية. سباق صعب. سنتعلم منه."},{"id":"second","category":"finish","file":"finish/second.mp3","duration":3.045,"priority":60,"cooldown":0,"text":"Second place! That was a brilliant fight.","ar":"المركز الثاني! كان قتالاً رائعاً."},{"id":"third","category":"finish","file":"finish/third.mp3","duration":2.565,"priority":60,"cooldown":0,"text":"Third place! Well done. That's a podium.","ar":"المركز الثالث! أحسنت. هذا منصة تتويج."},{"id":"retire","category":"finish","file":"finish/retire.mp3","duration":3.173,"priority":60,"cooldown":0,"text":"We'll have to retire the car. Tough luck today.","ar":"علينا سحب السيارة. حظ سيئ اليوم."},{"id":"disconnect","category":"finish","file":"finish/disconnect.mp3","duration":3.252,"priority":60,"cooldown":0,"text":"Connection lost. Waiting for the session to recover.","ar":"انقطع الاتصال. بانتظار عودة الجلسة."},{"id":"thank_you","category":"finish","file":"finish/thank_you.mp3","duration":3.076,"priority":60,"cooldown":0,"text":"Thanks for that drive. The whole team is proud of you.","ar":"شكراً على هذه القيادة. الفريق كله فخور بك."}]}